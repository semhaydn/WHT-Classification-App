DJANGO_SECRET_KEY=replace-this-for-local-use
DJANGO_ENVIRONMENT=development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
# Opt in only for the disposable Heroku demo; never for normal development.
HEROKU_DEMO_MODE=false
# For demo mode only, configure these securely in Heroku instead:
# DJANGO_SUPERUSER_USERNAME=<demo-username>
# DJANGO_SUPERUSER_PASSWORD=<strong-unique-password>
WHT_IMPORT_STAGING_DIR=
WHT_IMPORT_MAX_FILE_SIZE=10485760
WHT_IMPORT_STAGING_TTL_HOURS=24
# Example development/demo opt-in; supply an API key separately.
OPENAI_API_KEY=
OPENAI_COST_TYPE_MODEL=gpt-5.6-luna
LLM_COST_TYPE_RECOMMENDATIONS_ENABLED=false
